{
  "kind": "collectionType",
  "collectionName": "tours",
  "info": {
    "singularName": "tour",
    "pluralName": "tours",
    "displayName": "Tour"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string"
    },
    "identifier": {
      "type": "string"
    },
    "featureName": {
      "type": "string"
    },
    "isActive": {
      "type": "boolean"
    },
    "launchTrigger": {
      "type": "enumeration",
      "default": "route",
      "enum": [
        "route",
        "click"
      ]
    },
    "path": {
      "type": "string"
    },
    "ordinal": {
      "type": "integer"
    },
    "renderMode": {
      "type": "enumeration",
      "default": "spotlight",
      "enum": [
        "overlay",
        "spotlight"
      ]
    },
    "overlayColor": {
      "type": "string",
      "default": "rgba(32, 32, 32, 0.3)"
    },
    "stepsList": {
      "type": "component",
      "component": "tour-step.steps",
      "repeatable": true
    },
    "skipLimit": {
      "type": "integer",
      "default": 5,
      "min": 0
    },
    "dismissBehavior": {
      "type": "enumeration",
      "default": "confirm",
      "enum": [
        "confirm",
        "immediate"
      ]
    }
  }
}
