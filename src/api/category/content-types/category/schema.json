{
  "kind": "collectionType",
  "collectionName": "categories",
  "info": {
    "singularName": "category",
    "pluralName": "categories",
    "displayName": "Category",
    "description": "A Codex sidebar bucket. Ordinal sets the order. Icon is a key the app knows: home, quotes, project, ship, help, book."
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string"
    },
    "slug": {
      "type": "uid"
    },
    "articles": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::article.article",
      "mappedBy": "category"
    },
    "description": {
      "type": "text"
    },
    "ordinal": {
      "type": "integer",
      "default": 0,
      "required": true
    },
    "icon": {
      "type": "enumeration",
      "enum": ["home", "quotes", "project", "ship", "help", "book"],
      "default": "book"
    },
    "audience": {
      "type": "enumeration",
      "enum": ["internal", "client", "all"],
      "default": "all",
      "required": true
    },
    "workflows": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::workflow.workflow",
      "mappedBy": "category"
    }
  }
}
